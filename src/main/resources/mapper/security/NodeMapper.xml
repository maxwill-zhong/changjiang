<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.les.decisionsupport.ods.security.mapper.NodeMapper">
    <!-- 通用字段映射 -->
    <sql id="Base_Column_List">
        id, name, type, note, parent_id, remark, update_by, update_time, create_time, create_by
    </sql>

    <!-- 自定义分页查询 -->
    <select id="selectByCustomQuery" resultType="com.les.decisionsupport.ods.security.model.Node">
        SELECT
        <include refid="Base_Column_List"/>
        FROM kg_node
        <where>
            <if test="query.name != null and query.name != ''">
                AND name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.type != null and query.type != ''">
                AND type = #{query.type}
            </if>
            <if test="query.parentId != null and query.parentId != ''">
                AND parent_id = #{query.parentId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>
